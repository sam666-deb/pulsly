{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulsly",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pulsly-db",
      "database_id": "c862b521-861a-485d-a97b-e6afd93a55b2"
    }
  ]
}
